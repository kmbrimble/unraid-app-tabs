<?php
// Thin host for the App Tabs web app, which lives at plugins/app.tabs/app/ and is served by the webGUI itself (same
// session, same CSRF). No config access and no markup of its own here: the whole UI is the iframe, and the same URL
// opens standalone via "Open full page". Settings, Utilities, App Tabs.
$app = '/plugins/app.tabs/app/index.php';
?>
<style>
  #atb-set-bar { display: flex; justify-content: flex-end; margin: 0 0 6px; }
  #atb-set-frame { display: block; width: 100%; height: 70vh; border: 0; background: transparent; }
</style>
<div id="atb-set-bar"><a href="<?= $app ?>" target="_blank" rel="noopener">Open full page</a></div>
<iframe id="atb-set-frame" title="App Tabs" src="<?= $app ?>"></iframe>
<script>
(function () {
  'use strict';
  // Fill the viewport below the Unraid header so the app scrolls inside the frame and the page itself does not.
  // footer#footer is fixed on the wide themes and in-flow on narrow ones; either way, trim any remaining page
  // overflow (the stock content padding) so there is no second scrollbar.
  var frame = document.getElementById('atb-set-frame');
  function fit() {
    var footer = document.getElementById('footer');
    var below = footer && getComputedStyle(footer).position === 'fixed' ? footer.offsetHeight : 0;
    var h = window.innerHeight - frame.getBoundingClientRect().top - below - 8;
    frame.style.height = Math.max(320, h) + 'px';
    var over = document.documentElement.scrollHeight - window.innerHeight;
    if (over > 0) frame.style.height = Math.max(320, frame.offsetHeight - over) + 'px';
  }
  window.addEventListener('resize', fit);
  window.addEventListener('load', fit);
  fit();
  setTimeout(fit, 400);
})();
</script>
