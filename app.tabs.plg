<?xml version="1.0" standalone="yes"?>

<!--
App Tabs: turn a list of web apps into Unraid top-bar tabs, each embedding the app in an iframe.
https://git.kiztigs.com/kmbrimble/unraid-app-tabs

Not distributed via Community Applications. Install by URL from
Plugins -> Install Plugin, using this file's raw git.kiztigs.com URL.
See README.md and CLAUDE.md for design and the release process.
-->

<!DOCTYPE PLUGIN [
<!ENTITY name      "app.tabs">
<!ENTITY author    "kmbrimble">
<!ENTITY version   "0.2.0">
<!ENTITY launch    "Settings/AppTabs">
<!ENTITY pluginURL "https://git.kiztigs.com/kmbrimble/unraid-app-tabs/raw/branch/main/app.tabs.plg">
<!ENTITY gitURL    "https://git.kiztigs.com/kmbrimble/unraid-app-tabs/releases/download/v&version;">
<!ENTITY plgPATH   "/boot/config/plugins/&name;">
<!ENTITY emhttp    "/usr/local/emhttp/plugins/&name;">
<!ENTITY md5       "1dbc988704d8b7c36597497ae8b8ebaf">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" support="https://git.kiztigs.com/kmbrimble/unraid-app-tabs" min="7.0" icon="window-restore">

<CHANGES>
###0.2.0
- New tab kind: Docker console. A top-bar tab can now show a live terminal for a container (a tmux session, for example
  `docker exec -it claude-code tmux attach -t claude`, or a plain sh/bash shell) inside the page, instead of the Docker tab's
  Console popup. Set it up under Settings, Utilities, App Tabs: Kind, A Docker console, then the container name and an
  optional tmux session.
- It uses Unraid's own terminal server (ttyd) on a root-only socket, behind your Unraid login, exactly as the Docker tab's
  Console does: no extra port, password or token, and nothing runs inside the container. It is a writable terminal in the
  container and is as privileged as Unraid's own terminal. It starts only when the tab's page is opened by a signed-in
  browser (never at install or boot), shows a clear message if the container is stopped or missing or the tmux session is
  gone, keeps one terminal server per tab however often you reload, and stops it when the tab is edited, disabled or deleted.
- Closing the browser tab no longer leaves a stray client behind in the container (a plain `docker exec -it` does; for tmux
  that would leave ghost clients that can shrink the session): each connection is cleaned up when it ends.
- Your existing tabs are untouched. A list of web-app tabs is saved exactly as before; the file becomes version 2 only
  while a console tab exists (version 0.1.x refuses such a file rather than misreading it, so downgrading with a console
  tab present needs the console tab removed first).

###0.1.1
- Delivery moved to Gitea (git.kiztigs.com): the plugin file and its release
  packages now come from the Gitea repository instead of GitHub, so the server
  needs to reach git.kiztigs.com to check for and fetch App Tabs updates. No
  change to what App Tabs does.

###0.1.0
- First release. App Tabs turns a list of web apps into top-bar tabs, placed after NetMan, each embedding the app
  in an iframe (or opening it in a new browser tab). Manage the list under Settings, Utilities, App Tabs: add,
  edit, delete (with confirmation), reorder with up/down buttons, enable/disable. A URL may use [HOST] for the
  hostname you opened Unraid with, so http://[HOST]:9898/ follows whatever address you use. Only http and https
  are accepted; an https GUI with an http app gets a clear message instead of a blank box (mixed content).
- Config lives on flash in tabs.json (written atomically, validated on load; a bad file is reported on the
  settings page and generates no tabs). The tab pages are generated from it on save, on install and at every boot.
  Labels and URLs are treated as untrusted: a URL is never written into a generated page, and labels are held to
  a strict character set.
- Known limits: an app that forbids embedding (X-Frame-Options or CSP frame-ancestors) cannot be detected from a page,
  so its tab stays blank; use Open full page. An http app under an https GUI is blocked by the browser (a message is shown).
</CHANGES>

<FILE Name="&plgPATH;/&name;-&version;.txz">
<URL>&gitURL;/&name;-&version;.txz</URL>
<MD5>&md5;</MD5>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
set -e

# No separate md5 re-check here: the .txz FILE block's own MD5 above is already verified by the plugin manager
# before this script runs. A second check against a sidecar goes stale across upgrades and breaks the install.

upgradepkg --install-new &plgPATH;/&name;-&version;.txz

# Keep only the package just installed; superseded ones would otherwise pile up on flash.
find &plgPATH; -maxdepth 1 -name '&name;-*.txz' ! -name '&name;-&version;.txz' -delete

mkdir -p &plgPATH;

# The top-bar tab pages are generated files (not part of the package): rebuild them from the flash config on every
# install, upgrade and boot (this block is the boot hook, because /usr/local/emhttp is restored from the OS image).
# A config that does not load is reported and generates no tabs; it must never fail the install.
if [[ -f &emhttp;/include/generate.php ]]; then
  php &emhttp;/include/generate.php || echo "app.tabs: tabs.json needs attention (see above); no tabs were generated."
fi

echo "app.tabs: install complete"
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
# The installed tree (including the generated tab pages) is removed. The config in &plgPATH; (tabs.json and its
# .bak) is deliberately KEPT so a reinstall brings the tabs back; delete that directory by hand to wipe it.
# Stop any console terminal servers the tabs started (they live in RAM under /var/tmp, not in the package).
if [[ -f &emhttp;/include/console-stop.php ]]; then
  php &emhttp;/include/console-stop.php || true
fi
removepkg &name;-&version;
rm -rf &emhttp;

echo "app.tabs: removed. &plgPATH;/tabs.json was left in place."
</INLINE>
</FILE>

</PLUGIN>
